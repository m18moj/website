# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# development | production. Defaults to "development" if unset. Set this to
# "production" on the live server — it tightens cookie/session security
# settings (e.g. secure cookies) that would otherwise break local HTTP dev.
NODE_ENV=development

# Optional override for the SQLite database file path. Defaults to
# data/scripforge.db. Mainly useful for pointing a throwaway/test run at a
# separate DB file without touching the real one.
DB_PATH=

# Automated daily backups (server/scripts/backup-db.js) — a consistent
# snapshot of the database is written every night at 3:30am server time.
# Set BACKUP_ENABLED=false to turn the schedule off (e.g. for local dev).
# BACKUP_DIR defaults to data/backups — point it at a different disk/mount
# for real redundancy. BACKUP_KEEP is how many snapshots to retain (default 14).
# Run `npm run backup` any time for a one-off manual backup.
BACKUP_ENABLED=
BACKUP_DIR=
BACKUP_KEEP=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# From https://dashboard.stripe.com/test/apikeys (use the *test mode* keys while developing locally)
STRIPE_SECRET_KEY=sk_test_...

# From the Stripe CLI when forwarding webhooks locally, e.g.:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# The CLI prints a "whsec_..." value the first time you run it — put that here.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: lets customers pay in crypto instead of by card, via NOWPayments'
# hosted checkout (broader country availability than Coinbase Commerce, which
# now gates signup behind "Coinbase Business" in some regions). Leave blank
# to skip crypto payments entirely — the "Pay with Crypto" button will just
# show a clear "not configured" error. Get both from https://nowpayments.io
# after creating a free account: the API key from Store Settings, and the
# IPN secret from Store Settings > "IPN Secret Key" (also set your IPN
# callback URL there to https://<your-domain>/api/webhooks/nowpayments; use
# ngrok or similar to test webhooks locally, since NOWPayments can't reach
# localhost directly).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Used only by `npm run create-admin` to seed/promote an admin account.
# Optional — you can also pass --username/--password as CLI flags instead.
# Run this more than once with different usernames to create multiple admins.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional — powers password-reset and order-receipt emails. Leave blank to
# skip email entirely: forgot-password will tell the user no email is on
# file, and receipts just get logged to the console instead of sent. Any
# standard SMTP provider works (Gmail app password, SendGrid, Mailgun, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ScripForge <no-reply@yourdomain.com>

# --- Social automation signal sources (social/platforms/) ---
# All optional — each source degrades gracefully to a no-op when its env vars
# are missing. The scheduler still runs the fetcher; it just returns
# { ok: false, reason: 'not configured' } and nothing is stored.

# TikTok Creative Center trending hashtags/sounds (social/platforms/tiktokTrends.js).
# Session cookie from https://ads.tiktok.com/business/creativecenter/ — expires
# every few weeks and needs manual refresh. Region controls which market's
# trending data is fetched (default: US).
TIKTOK_CC_COOKIE=
TIKTOK_CC_REGION=US

# Twitter/X trending topics (social/platforms/twitter.js) — requires a
# Bearer Token from the Twitter Developer Portal (Free tier is fine for
# read-only trend data). Search queries default to the Roblox scripting niche
# if not set.
TWITTER_BEARER_TOKEN=
TWITTER_SEARCH_QUERIES=

# Discord signal channel monitoring (social/platforms/discordSignal.js) —
# tracks message velocity in specified channels. Needs a Discord bot token
# with message-history read access and the channel IDs to watch.
DISCORD_BOT_TOKEN=
DISCORD_SIGNAL_CHANNEL_IDS=

# Twitch top games + clip velocity (social/platforms/twitch.js) — get
# Client ID and Secret from https://dev.twitch.tv/console/apps.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google Trends interest-over-time (social/platforms/googleTrends.js).
# Keywords, geo, and timeframe are configurable but have sensible defaults
# covering the Roblox/gaming scripting niche.
GOOGLE_TRENDS_KEYWORDS=
GOOGLE_TRENDS_GEO=
GOOGLE_TRENDS_TIMEFRAME=

# Wikipedia pageview spikes (social/platforms/wikipedia.js). Comma-separated
# article names to monitor (default: Roblox,Fortnite,Minecraft).
WIKIPEDIA_ARTICLES=
WIKIPEDIA_PROJECT=
WIKIPEDIA_USER_AGENT=

# App Store / Google Play chart tracking (social/platforms/appStoreCharts.js).
# Comma-separated app IDs or names to watch (defaults cover Roblox/Minecraft
# related apps).
APPSTORE_APPLE_APPS=
APPSTORE_PLAY_APP_IDS=

# Gaming news RSS feeds (social/platforms/newsRss.js). Comma-separated feed
# URLs and keyword filters — defaults are general gaming press; swap for
# Roblox/dev-tools feeds before production.
NEWS_RSS_FEEDS=
NEWS_RSS_KEYWORDS=
NEWS_RSS_LOOKBACK_HOURS=72

# Roblox DevForum announcements (social/platforms/robloxDevForum.js) — no auth
# needed, just a user agent string (has a default).

# --- Trend intelligence features ---

# Optional: Discord or Slack incoming webhook URL for trend alerts. When set,
# GET /api/trend-insights/alerts pings it (rate-limited to once per topic
# per 6 hours) whenever a rising trend crosses the confidence/momentum
# threshold. Unset by default — the in-dashboard alert banner works without it.
TREND_ALERT_WEBHOOK_URL=
