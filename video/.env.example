# Video pipeline environment — all optional. Copy to video/.env and fill in
# only what you want to override. This file is checked before the store's
# root .env and discord-bot/.env (see pipeline/lib/env.mjs), so most setups
# need nothing here at all: the pipeline already reuses the ANTHROPIC_API_KEY
# from discord-bot/.env for ad-copy generation, and uses Microsoft Edge's
# free neural TTS voices by default (human-sounding, no API key — just needs
# `pip install edge-tts` and internet), falling back to Windows' built-in
# SAPI voices (free, offline) when Edge isn't available.

# --- Voiceover (free + optional premium upgrade) ------------------------
# The default free engine is Microsoft Edge's neural TTS via the `edge_tts`
# Python package (sounds human, no API key). Install it with:
#   pip install edge-tts        (or: npm run video:tts-setup)
# The dispatcher (pipeline/lib/tts.mjs) tries: ElevenLabs (if key set) ->
# Edge neural (free, needs internet) -> Windows SAPI (free, offline).
# Set to "sapi" to force the offline Windows SAPI engine, or "edge"/"elevenlabs"
# to require a specific one.
# VIDEO_TTS_ENGINE=auto

# Microsoft Edge neural voice to use (see `python -m edge_tts --list-voices`).
# Defaults to en-US-EmmaMultilingualNeural — clear, conversational, good for ads.
# EDGE_TTS_VOICE=en-US-EmmaMultilingualNeural

# If set, the pipeline uses ElevenLabs for premium TTS with real
# character-level timestamp alignment instead of Edge/SAPI. Get a key at
# https://elevenlabs.io.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Preferred Windows SAPI voice name (e.g. "Microsoft David Desktop" or
# "Microsoft Zira Desktop"), used only when falling back to SAPI. Leave unset
# to use the system default voice.
# VIDEO_TTS_VOICE=

# --- Ad copy ------------------------------------------------------------
# Overrides the Claude model used for hook/beats/CTA copy generation.
# Defaults to claude-sonnet-5, matching discord-bot/assistant.js.
# ANTHROPIC_MODEL=claude-sonnet-5

# ANTHROPIC_API_KEY is normally picked up from discord-bot/.env automatically
# (the same key that powers the site's assistant). Only set it here if you
# want the video pipeline to use a separate key.
# ANTHROPIC_API_KEY=
