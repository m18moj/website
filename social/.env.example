# Copy to social/.env and fill in real values. Never commit .env — see
# README.md's "AI/Social automation" section for the full setup walkthrough.

# --- Safety gates ---------------------------------------------------------

# Master kill switch. Leave unset/false while testing: the pipeline still
# runs end-to-end (strategy/script/creative/QA/scheduling, including real
# LLM calls if ANTHROPIC_API_KEY is set), but publish_due_posts refuses to
# actually call a platform API until this is exactly "true".
SOCIAL_ENABLED=false

# When true (the default), publish_due_posts logs what it would post instead
# of calling the platform API — lets you validate the whole chain, including
# real agent output, without risking a live post. Set to "false" together
# with SOCIAL_ENABLED=true when you're ready to actually go live.
SOCIAL_DRY_RUN=true

# --- Anthropic (required — every agent needs this) ------------------------

# From https://console.anthropic.com/settings/keys. Every agent (strategy,
# script, creative direction, product promotion, trends synthesis, QA,
# publishing metadata, analytics/learning) uses this; without it, every
# LLM-backed pipeline stage fails (and retries with backoff) until set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Site / scheduling ------------------------------------------------------

# Used to build catalog links in generated video descriptions/captions.
# Falls back to https://scripforge.net if unset (same default as
# discord-bot/.env.example's SITE_URL).
SITE_URL=

# How many non-triggered ("evergreen") campaigns to start per day, rotating
# through the catalog and split across TikTok/YouTube. New-pack detection and
# trend-driven campaigns happen on top of this, independently.
SOCIAL_EVERGREEN_PER_DAY=2

# --- YouTube (optional — leave blank to skip YouTube Shorts entirely) -----

# From a Google Cloud project with the YouTube Data API v3 enabled:
# APIs & Services -> Credentials -> Create Credentials -> API key. Used
# read-only, for trend discovery (videos.list chart=mostPopular) and pulling
# stats on our own published videos — never for posting.
YOUTUBE_API_KEY=

# From the same project: Credentials -> Create Credentials -> OAuth client ID
# -> Application type "Web application". Add the redirect URI printed by
# `npm run social:youtube-auth` (defaults to http://localhost:8934/oauth2callback)
# under "Authorized redirect URIs" before running that script.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Minted once by `npm run social:youtube-auth` — do not set by hand.
YOUTUBE_REFRESH_TOKEN=

# Find at https://studio.youtube.com -> Settings -> Channel -> Advanced settings.
YOUTUBE_CHANNEL_ID=

# --- TikTok (optional — leave blank to skip TikTok entirely) --------------

# From https://developers.tiktok.com -> your app -> Content Posting API
# added and approved for the video.publish and video.list scopes.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must be HTTPS — TikTok does not allow localhost/HTTP redirect URIs, unlike
# Google's OAuth flow above. Doesn't need to be a live page; you'll copy the
# `code` param from the browser's address bar by hand when running
# `npm run social:tiktok-auth`. Register the same value under your TikTok
# app's "Redirect URI" setting first.
TIKTOK_OAUTH_REDIRECT_URI=

# Minted once by `npm run social:tiktok-auth` — do not set by hand.
TIKTOK_REFRESH_TOKEN=

# --- Optional tuning (sensible defaults if unset) --------------------------

# How often the job runner polls social_jobs for due work, in milliseconds.
SOCIAL_POLL_INTERVAL_MS=10000
# Max jobs claimed per poll tick.
SOCIAL_BATCH_SIZE=5

# Optional override for the SQLite database file path — same convention as
# the web server and Discord bot; only needed if you've customized DB_PATH
# for them too (all three must point at the same file).
DB_PATH=
