# Copy to discord-bot/.env and fill in real values. Never commit .env — a
# leaked bot token is equivalent to full Administrator access to the server.
# If a token is ever exposed, regenerate it immediately at
# https://discord.com/developers/applications (Bot tab -> Reset Token).

# From the Discord Developer Portal: Applications -> your app -> Bot -> Token.
DISCORD_BOT_TOKEN=

# Applications -> your app -> General Information -> Application ID.
# Used by deploy-commands.js to register slash commands.
DISCORD_CLIENT_ID=

# Your server's ID (enable Developer Mode in Discord, right-click the server
# icon -> Copy Server ID). If set, deploy-commands.js registers commands to
# this one guild only, which updates instantly — useful while developing.
# Leave blank to register commands globally (takes up to an hour to
# propagate, but works across every server the bot is in). This is also the
# "home guild" the website uses for Verified-role sync when someone links
# their Discord account from the Account page or completes a purchase — set
# it even if you don't need instant command deploys, or that role sync
# silently does nothing.
DISCORD_GUILD_ID=

# From https://console.anthropic.com/settings/keys — powers the shared
# assistant (Discord chat/DMs + the website's chat widget). Leave blank to
# disable the assistant; every other bot feature still works without it.
ANTHROPIC_API_KEY=

# Powers the website's "Connect Discord" button (Account page) — a real
# Discord OAuth2 flow, separate from the bot's /verify command. From the
# Discord Developer Portal: Applications -> your app -> OAuth2 -> Client
# Secret (click "Reset Secret" if you've never generated one). Leave either
# of these blank and the website button just shows as unavailable; /verify
# still works either way.
DISCORD_CLIENT_SECRET=

# Must be added, byte-for-byte identical, under Discord Developer Portal ->
# your app -> OAuth2 -> Redirects, or Discord will reject the callback.
# Example: https://scripforge.net/api/discord/callback (production) or
# http://localhost:3000/api/discord/callback (local dev).
DISCORD_OAUTH_REDIRECT_URI=

# Optional override for the SQLite database file path. Leave blank to use
# the same default as the web server (data/scripforge.db) — this only needs
# setting if the web server's DB_PATH is also customized.
DB_PATH=

# Real channel IDs this server already has (see server-tree.txt). /setup-server
# wires the bot to these EXISTING channels — it never creates new ones. Every
# one of these already defaults to the correct ID for this server in
# discord-bot/config.js, so you only need to set one here if a channel gets
# deleted/recreated and its ID changes.
DISCORD_PRODUCT_CHANNEL_ID=1537738559518285845    # --STORE-- products
DISCORD_CATALOGUE_CHANNEL_ID=1537738562181791765  # --STORE-- pricing
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=1537738542988664892  # --INFORMATION-- announcements
DISCORD_GENERAL_CHANNEL_ID=1537738574894600202     # --COMMUNITY-- general
DISCORD_SUPPORT_CHANNEL_ID=1537738611150032896     # --SUPPORT-- open-ticket
DISCORD_VIP_CHANNEL_ID=1537738570410893354         # --STORE-- vip-lounge
DISCORD_MOD_LOG_CHANNEL_ID=1537738621291864084     # --STAFF-- mod-log
DISCORD_TICKET_LOG_CHANNEL_ID=1537738622856593489  # --STAFF-- sales-log
DISCORD_STAFF_CHAT_CHANNEL_ID=1537738619404427284  # --STAFF-- staff-chat

# Category a new ticket channel is created under whenever a customer pays for
# a Discord bot, website, or SMM plan (server/orderFulfillment.js ->
# discord-bot/serviceOrderTicket.js). Defaults to the custom-builds category
# already in use; only set this if that category is ever recreated/renamed.
DISCORD_CUSTOM_BUILDS_CATEGORY_ID=1538274290112405599

# Used to build absolute links in embeds/DMs the bot sends (product
# announcements, the catalogue message, the onboarding "Verify" button).
# Set this to your real public site URL once you have one — falls back to
# https://scripforge.net if unset.
SITE_URL=
